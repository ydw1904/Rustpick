{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustpick",
  "version": "0.1.0",
  "identifier": "com.rustpick.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rustpick",
        "width": 980,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
